{
  "version": 2,
  "builds": [
    {
      "src": "src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.js"
    }
  ],
  "env": {
    "DISCORD_TOKEN": "@discord_token",
    "DATABASE_URL": "@database_url",
    "BOT_API_SECRET": "@bot_api_secret",
    "BOT_API_PORT": "3001"
  }
}
